@using EmployeeDirectory.BLL
@using EmployeeDirectory.Web.UI.Components.Pages;

<div class="employee-tree-container ">
    <!-- Apply root-node class if it's the root -->
    <div class=" @(IsRoot ? "root-node" : "") employee-card">
        <div class="employee-info">
            <h4>@EmployeeNode.Employee.Name</h4>
        </div>
    </div>

    @if (EmployeeNode.Subordinates != null && EmployeeNode.Subordinates.Any())
    {
        <div class="arrow-down"></div> <!-- Downward arrow to indicate subordinates -->
        <div class="subordinates-row">
            @foreach (var subordinate in EmployeeNode.Subordinates)
            {
                <EmployeeTree EmployeeNode="subordinate" SelectedEmployee="SelectedEmployee" RootEmployee="RootEmployee" />
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public EmployeeTreeNode EmployeeNode { get; set; }

    [Parameter]
    public EmployeeDTO RootEmployee { get; set; }
    [Parameter]
    public EmployeeDTO SelectedEmployee{ get; set; }

    private bool IsRoot => EmployeeNode.Employee.Id == SelectedEmployee.Id; // Check if this is the root node

}


<style>

    .root-node {
        border: 2px solid #007bff; /* Blue border for highlighting */
        background-color: #e7f1ff; /* Light blue background */
        padding: 10px;
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.5);
    }

        .root-node .employee-card {
            background-color: #f7fbff;
            border: 2px solid #007bff; /* Blue border for highlighting */
            background-color: #e7f1ff;
        }

    .employee-tree-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 20px;
    }

    .employee-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 200px;
    }

    .profile-picture {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 10px;
    }

    .employee-info {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .employee-info h4 {
            margin: 0;
            font-size: 16px;
            font-weight: bold;
        }

        .employee-info p {
            margin: 5px 0 0 0;
            font-size: 14px;
            color: #666;
        }

    .arrow-down {
        width: 0;
        height: 0;
        border-left: 10px solid transparent;
        border-right: 10px solid transparent;
        border-top: 15px solid #ccc;
        margin: 10px 0;
    }

    .subordinates-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

        .subordinates-row .employee-tree-container {
            margin: 0;
        }

</style>